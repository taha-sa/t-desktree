<!-- Renk token'lari: Dark tema. Iki Tokens dosyasinin anahtar kumesi birebir ayni olmali. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="TSuite/Tokens.Dark.xaml" />
    </ResourceDictionary.MergedDictionaries>


    <SolidColorBrush x:Key="Brush.Bg.Base" Color="{DynamicResource Color.color.neutral.dark.bg}" />
    <!-- Maps Color.color.neutral.dark.surface1 for drawing code. -->
    <Color x:Key="Color.Bg.Surface">#FF16191E</Color>
    <SolidColorBrush x:Key="Brush.Bg.Surface" Color="{DynamicResource Color.color.neutral.dark.surface1}" />
    <!-- Maps Color.color.neutral.dark.surface2 for drawing code. -->
    <Color x:Key="Color.Bg.Elevated">#FF1E2229</Color>
    <SolidColorBrush x:Key="Brush.Bg.Elevated" Color="{DynamicResource Color.color.neutral.dark.surface2}" />
    <!-- Maps Color.color.neutral.dark.surface3 for drawing code. -->
    <Color x:Key="Color.Bg.Subtle">#FF272D36</Color>
    <SolidColorBrush x:Key="Brush.Bg.Subtle" Color="{DynamicResource Color.color.neutral.dark.surface3}" />
    <!-- Maps Color.color.neutral.dark.border for drawing code. -->
    <Color x:Key="Color.Border.Default">#FF2E3440</Color>
    <SolidColorBrush x:Key="Brush.Border.Default" Color="{DynamicResource Color.color.neutral.dark.border}" />
    <!-- Maps Color.color.neutral.dark.borderStrong for drawing code. -->
    <Color x:Key="Color.Border.Strong">#FF434C5E</Color>
    <SolidColorBrush x:Key="Brush.Border.Strong" Color="{DynamicResource Color.color.neutral.dark.borderStrong}" />
    <!-- Maps Color.color.neutral.dark.text for drawing code. -->
    <Color x:Key="Color.Text.Primary">#FFECEFF4</Color>
    <SolidColorBrush x:Key="Brush.Text.Primary" Color="{DynamicResource Color.color.neutral.dark.text}" />
    <!-- Maps Color.color.neutral.dark.textMuted for drawing code. -->
    <Color x:Key="Color.Text.Secondary">#FF9CA3AF</Color>
    <SolidColorBrush x:Key="Brush.Text.Secondary" Color="{DynamicResource Color.color.neutral.dark.textMuted}" />
    <!-- Maps Color.color.neutral.dark.textFaint for drawing code. -->
    <Color x:Key="Color.Text.Muted">#FF6B7280</Color>
    <SolidColorBrush x:Key="Brush.Text.Muted" Color="{DynamicResource Color.color.neutral.dark.textFaint}" />

    <SolidColorBrush x:Key="Brush.Accent" Color="{DynamicResource Color.color.accent.tDeskTree.dark.base}" />

    <SolidColorBrush x:Key="Brush.Accent.Hover" Color="{DynamicResource Color.color.accent.tDeskTree.dark.hover}" />

    <SolidColorBrush x:Key="Brush.Accent.Pressed" Color="{DynamicResource Color.color.accent.tDeskTree.dark.pressed}" />
    <!-- Maps Color.color.accent.tDeskTree.dark.onAccent for drawing code. -->
    <Color x:Key="Color.Accent.Fg">#FF041D1A</Color>
    <SolidColorBrush x:Key="Brush.Accent.Fg" Color="{DynamicResource Color.color.accent.tDeskTree.dark.onAccent}" />
    <!-- Maps Color.color.accent.tDeskTree.dark.subtle for drawing code. -->
    <Color x:Key="Color.Accent.Soft">#1A2DD4BF</Color>
    <SolidColorBrush x:Key="Brush.Accent.Soft" Color="{DynamicResource Color.color.accent.tDeskTree.dark.subtle}" />
    <!-- Maps Color.color.state.dark.danger.base for drawing code. -->
    <Color x:Key="Color.Danger">#FFEF4444</Color>
    <SolidColorBrush x:Key="Brush.Danger" Color="{DynamicResource Color.color.state.dark.danger.base}" />
    <!-- Maps Color.color.state.dark.danger.base for drawing code. -->
    <Color x:Key="Color.Danger.Hover">#FFEF4444</Color>
    <SolidColorBrush x:Key="Brush.Danger.Hover" Color="{DynamicResource Color.color.state.dark.danger.base}" />
    <!-- Maps Color.color.state.dark.danger.onState for drawing code. -->
    <Color x:Key="Color.Danger.Fg">#FF2B0505</Color>
    <SolidColorBrush x:Key="Brush.Danger.Fg" Color="{DynamicResource Color.color.state.dark.danger.onState}" />
    <!-- Maps Color.color.state.dark.danger.subtle for drawing code. -->
    <Color x:Key="Color.Danger.Soft">#1AEF4444</Color>
    <SolidColorBrush x:Key="Brush.Danger.Soft" Color="{DynamicResource Color.color.state.dark.danger.subtle}" />
    <!-- Maps Color.color.state.dark.warning.base for drawing code. -->
    <Color x:Key="Color.Warning">#FFF59E0B</Color>
    <SolidColorBrush x:Key="Brush.Warning" Color="{DynamicResource Color.color.state.dark.warning.base}" />
    <!-- Maps Color.color.state.dark.warning.subtle for drawing code. -->
    <Color x:Key="Color.Warning.Soft">#1AF59E0B</Color>
    <SolidColorBrush x:Key="Brush.Warning.Soft" Color="{DynamicResource Color.color.state.dark.warning.subtle}" />
    <!-- Maps Color.color.state.dark.success.base for drawing code. -->
    <Color x:Key="Color.Success">#FF10B981</Color>
    <SolidColorBrush x:Key="Brush.Success" Color="{DynamicResource Color.color.state.dark.success.base}" />
    <!-- Maps Color.color.state.dark.success.subtle for drawing code. -->
    <Color x:Key="Color.Success.Soft">#1A10B981</Color>
    <SolidColorBrush x:Key="Brush.Success.Soft" Color="{DynamicResource Color.color.state.dark.success.subtle}" />
    <Color x:Key="Color.Shadow">#000000</Color>
    <SolidColorBrush x:Key="Brush.Shadow" Color="{DynamicResource Color.Shadow}" />
    <Color x:Key="Color.Cat.Video">#7C6CF2</Color>
    <SolidColorBrush x:Key="Brush.Cat.Video" Color="{DynamicResource Color.Cat.Video}" />
    <Color x:Key="Color.Cat.Image">#3DA5F2</Color>
    <SolidColorBrush x:Key="Brush.Cat.Image" Color="{DynamicResource Color.Cat.Image}" />
    <Color x:Key="Color.Cat.Audio">#E879C6</Color>
    <SolidColorBrush x:Key="Brush.Cat.Audio" Color="{DynamicResource Color.Cat.Audio}" />
    <Color x:Key="Color.Cat.Archive">#F2B455</Color>
    <SolidColorBrush x:Key="Brush.Cat.Archive" Color="{DynamicResource Color.Cat.Archive}" />
    <Color x:Key="Color.Cat.Code">#4CC38A</Color>
    <SolidColorBrush x:Key="Brush.Cat.Code" Color="{DynamicResource Color.Cat.Code}" />
    <Color x:Key="Color.Cat.Executable">#F2616B</Color>
    <SolidColorBrush x:Key="Brush.Cat.Executable" Color="{DynamicResource Color.Cat.Executable}" />
    <!-- Maps Color.color.accent.tDeskTree.dark.base for drawing code. -->
    <Color x:Key="Color.Cat.Document">#FF2DD4BF</Color>
    <SolidColorBrush x:Key="Brush.Cat.Document" Color="{DynamicResource Color.color.accent.tDeskTree.dark.base}" />
    <Color x:Key="Color.Cat.Other">#7C8494</Color>
    <SolidColorBrush x:Key="Brush.Cat.Other" Color="{DynamicResource Color.Cat.Other}" />
</ResourceDictionary>
