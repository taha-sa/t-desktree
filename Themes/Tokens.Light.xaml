<!-- Renk token'lari: Light tema. Iki Tokens dosyasinin anahtar kumesi birebir ayni olmali. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="TSuite/Tokens.Light.xaml" />
    </ResourceDictionary.MergedDictionaries>


    <SolidColorBrush x:Key="Brush.Bg.Base" Color="{DynamicResource Color.color.neutral.light.bg}" />
    <!-- Maps Color.color.neutral.light.surface1 for drawing code. -->
    <Color x:Key="Color.Bg.Surface">#FFFFFFFF</Color>
    <SolidColorBrush x:Key="Brush.Bg.Surface" Color="{DynamicResource Color.color.neutral.light.surface1}" />
    <!-- Maps Color.color.neutral.light.surface2 for drawing code. -->
    <Color x:Key="Color.Bg.Elevated">#FFF1F5F9</Color>
    <SolidColorBrush x:Key="Brush.Bg.Elevated" Color="{DynamicResource Color.color.neutral.light.surface2}" />
    <!-- Maps Color.color.neutral.light.surface3 for drawing code. -->
    <Color x:Key="Color.Bg.Subtle">#FFE2E8F0</Color>
    <SolidColorBrush x:Key="Brush.Bg.Subtle" Color="{DynamicResource Color.color.neutral.light.surface3}" />
    <!-- Maps Color.color.neutral.light.border for drawing code. -->
    <Color x:Key="Color.Border.Default">#FFCBD5E1</Color>
    <SolidColorBrush x:Key="Brush.Border.Default" Color="{DynamicResource Color.color.neutral.light.border}" />
    <!-- Maps Color.color.neutral.light.borderStrong for drawing code. -->
    <Color x:Key="Color.Border.Strong">#FF94A3B8</Color>
    <SolidColorBrush x:Key="Brush.Border.Strong" Color="{DynamicResource Color.color.neutral.light.borderStrong}" />
    <!-- Maps Color.color.neutral.light.text for drawing code. -->
    <Color x:Key="Color.Text.Primary">#FF0F172A</Color>
    <SolidColorBrush x:Key="Brush.Text.Primary" Color="{DynamicResource Color.color.neutral.light.text}" />
    <!-- Maps Color.color.neutral.light.textMuted for drawing code. -->
    <Color x:Key="Color.Text.Secondary">#FF475569</Color>
    <SolidColorBrush x:Key="Brush.Text.Secondary" Color="{DynamicResource Color.color.neutral.light.textMuted}" />
    <!-- Maps Color.color.neutral.light.textFaint for drawing code. -->
    <Color x:Key="Color.Text.Muted">#FF94A3B8</Color>
    <SolidColorBrush x:Key="Brush.Text.Muted" Color="{DynamicResource Color.color.neutral.light.textFaint}" />

    <SolidColorBrush x:Key="Brush.Accent" Color="{DynamicResource Color.color.accent.tDeskTree.light.base}" />

    <SolidColorBrush x:Key="Brush.Accent.Hover" Color="{DynamicResource Color.color.accent.tDeskTree.light.hover}" />

    <SolidColorBrush x:Key="Brush.Accent.Pressed" Color="{DynamicResource Color.color.accent.tDeskTree.light.pressed}" />
    <!-- Maps Color.color.accent.tDeskTree.light.onAccent for drawing code. -->
    <Color x:Key="Color.Accent.Fg">#FFFFFFFF</Color>
    <SolidColorBrush x:Key="Brush.Accent.Fg" Color="{DynamicResource Color.color.accent.tDeskTree.light.onAccent}" />
    <!-- Maps Color.color.accent.tDeskTree.light.subtle for drawing code. -->
    <Color x:Key="Color.Accent.Soft">#1A0F766E</Color>
    <SolidColorBrush x:Key="Brush.Accent.Soft" Color="{DynamicResource Color.color.accent.tDeskTree.light.subtle}" />
    <!-- Maps Color.color.state.light.danger.base for drawing code. -->
    <Color x:Key="Color.Danger">#FFB91C1C</Color>
    <SolidColorBrush x:Key="Brush.Danger" Color="{DynamicResource Color.color.state.light.danger.base}" />
    <!-- Maps Color.color.state.light.danger.base for drawing code. -->
    <Color x:Key="Color.Danger.Hover">#FFB91C1C</Color>
    <SolidColorBrush x:Key="Brush.Danger.Hover" Color="{DynamicResource Color.color.state.light.danger.base}" />
    <!-- Maps Color.color.state.light.danger.onState for drawing code. -->
    <Color x:Key="Color.Danger.Fg">#FFFFFFFF</Color>
    <SolidColorBrush x:Key="Brush.Danger.Fg" Color="{DynamicResource Color.color.state.light.danger.onState}" />
    <!-- Maps Color.color.state.light.danger.subtle for drawing code. -->
    <Color x:Key="Color.Danger.Soft">#1AB91C1C</Color>
    <SolidColorBrush x:Key="Brush.Danger.Soft" Color="{DynamicResource Color.color.state.light.danger.subtle}" />
    <!-- Maps Color.color.state.light.warning.base for drawing code. -->
    <Color x:Key="Color.Warning">#FFB45309</Color>
    <SolidColorBrush x:Key="Brush.Warning" Color="{DynamicResource Color.color.state.light.warning.base}" />
    <!-- Maps Color.color.state.light.warning.subtle for drawing code. -->
    <Color x:Key="Color.Warning.Soft">#1AB45309</Color>
    <SolidColorBrush x:Key="Brush.Warning.Soft" Color="{DynamicResource Color.color.state.light.warning.subtle}" />
    <!-- Maps Color.color.state.light.success.base for drawing code. -->
    <Color x:Key="Color.Success">#FF047857</Color>
    <SolidColorBrush x:Key="Brush.Success" Color="{DynamicResource Color.color.state.light.success.base}" />
    <!-- Maps Color.color.state.light.success.subtle for drawing code. -->
    <Color x:Key="Color.Success.Soft">#1A047857</Color>
    <SolidColorBrush x:Key="Brush.Success.Soft" Color="{DynamicResource Color.color.state.light.success.subtle}" />
    <Color x:Key="Color.Shadow">#000000</Color>
    <SolidColorBrush x:Key="Brush.Shadow" Color="{DynamicResource Color.Shadow}" />
    <Color x:Key="Color.Cat.Video">#6A59E0</Color>
    <SolidColorBrush x:Key="Brush.Cat.Video" Color="{DynamicResource Color.Cat.Video}" />
    <Color x:Key="Color.Cat.Image">#1E88DC</Color>
    <SolidColorBrush x:Key="Brush.Cat.Image" Color="{DynamicResource Color.Cat.Image}" />
    <Color x:Key="Color.Cat.Audio">#D159AE</Color>
    <SolidColorBrush x:Key="Brush.Cat.Audio" Color="{DynamicResource Color.Cat.Audio}" />
    <Color x:Key="Color.Cat.Archive">#CC8F26</Color>
    <SolidColorBrush x:Key="Brush.Cat.Archive" Color="{DynamicResource Color.Cat.Archive}" />
    <Color x:Key="Color.Cat.Code">#2BA06A</Color>
    <SolidColorBrush x:Key="Brush.Cat.Code" Color="{DynamicResource Color.Cat.Code}" />
    <Color x:Key="Color.Cat.Executable">#D23A45</Color>
    <SolidColorBrush x:Key="Brush.Cat.Executable" Color="{DynamicResource Color.Cat.Executable}" />
    <!-- Maps Color.color.accent.tDeskTree.light.base for drawing code. -->
    <Color x:Key="Color.Cat.Document">#FF0F766E</Color>
    <SolidColorBrush x:Key="Brush.Cat.Document" Color="{DynamicResource Color.color.accent.tDeskTree.light.base}" />
    <Color x:Key="Color.Cat.Other">#6B7383</Color>
    <SolidColorBrush x:Key="Brush.Cat.Other" Color="{DynamicResource Color.Cat.Other}" />
</ResourceDictionary>
