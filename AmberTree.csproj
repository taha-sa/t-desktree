<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>AmberTree</RootNamespace>
    <SatelliteResourceLanguages>en;tr;de</SatelliteResourceLanguages>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <AssemblyName>T-DeskTree</AssemblyName>
    <Version>1.2.0</Version>
    <Product>T-DeskTree Disk Space Analyzer</Product>
    <Description>High-performance disk space manager with Graphite / Aurora aesthetic</Description>
    <Company>tdesk.studio</Company>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="tests\**\*.cs" />
    <Page Remove="tests\**\*" />
    <EmbeddedResource Remove="tests\**\*" />
    <None Remove="tests\**\*" />
    <Resource Include="app.ico" />
    <Resource Include="Assets\logo.png" />
    <Resource Include="Assets\Family\*.png" />
  </ItemGroup>

  <!-- T-Suite SDK: kardes depo C:\Users\hp\Projects\t-suite (bkz. README.md). Baska yer icin: -p:TSuiteRoot=... -->
  <PropertyGroup>
    <TSuiteRoot Condition="'$(TSuiteRoot)' == ''">$(MSBuildProjectDirectory)\..\..\..\..\Projects\t-suite</TSuiteRoot>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(TSuiteRoot)\src\TSuite.Diagnostics\TSuite.Diagnostics.csproj" />
    <ProjectReference Include="$(TSuiteRoot)\src\TSuite.Link\TSuite.Link.csproj" />
    <ProjectReference Include="$(TSuiteRoot)\src\TSuite.Update\TSuite.Update.csproj" />
  </ItemGroup>

  <Import Project="$(TSuiteRoot)\build\TSuite.Updater.targets" />


  <ItemGroup>
    <EmbeddedResource Include="LICENSE" LogicalName="Legal.LICENSE" />
    <Content Include="LICENSE" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <EmbeddedResource Include="PRIVACY.md" LogicalName="Legal.PRIVACY.md" />
    <Content Include="PRIVACY.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <EmbeddedResource Include="THIRD-PARTY-NOTICES.md" LogicalName="Legal.THIRD-PARTY-NOTICES.md" />
    <Content Include="THIRD-PARTY-NOTICES.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
