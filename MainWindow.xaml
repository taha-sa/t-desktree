<Window x:Class="AmberTree.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:views="clr-namespace:AmberTree.Views"
        Title="AmberTree" Width="1180" Height="760" MinWidth="860" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Brush.Bg.Base}"
        FontFamily="{DynamicResource Font.UI}" FontSize="13"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0"
                            CornerRadius="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{Binding StartScanCommand}" />
        <KeyBinding Key="Escape" Command="{Binding EscapeCommand}" />
        <KeyBinding Key="F" Modifiers="Ctrl" Command="{Binding FocusSearchCommand}" />
        <KeyBinding Key="Delete" Command="{Binding RecycleCommand}" />
        <KeyBinding Key="Delete" Modifiers="Shift" Command="{Binding DeletePermanentCommand}" />
        <KeyBinding Key="D1" Modifiers="Ctrl" Command="{Binding NavigateCommand}" CommandParameter="1" />
        <KeyBinding Key="D2" Modifiers="Ctrl" Command="{Binding NavigateCommand}" CommandParameter="2" />
        <KeyBinding Key="D3" Modifiers="Ctrl" Command="{Binding NavigateCommand}" CommandParameter="3" />
        <KeyBinding Key="D4" Modifiers="Ctrl" Command="{Binding NavigateCommand}" CommandParameter="4" />
        <KeyBinding Key="D5" Modifiers="Ctrl" Command="{Binding NavigateCommand}" CommandParameter="5" />
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Baslik cubugu -->
        <views:TitleBar Grid.Row="0" />

        <!-- Komut cubugu -->
        <views:CommandBar Grid.Row="1" />

        <!-- Hata bildirimi (her durumda ustte) -->
        <Border Grid.Row="2" Style="{StaticResource Border.InfoBar.Error}" Margin="16,8,16,0"
                Visibility="{Binding HasError, Converter={StaticResource Conv.BoolToVis}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{StaticResource Icon.Error}" Style="{StaticResource Text.Icon}"
                           Foreground="{DynamicResource Brush.Danger}" VerticalAlignment="Center" Margin="0,0,12,0" />
                <TextBlock Grid.Column="1" Text="{Binding ErrorMessage}" Style="{StaticResource Text.Body}"
                           TextWrapping="Wrap" VerticalAlignment="Center" />
                <Button Grid.Column="2" Style="{StaticResource Button.Icon}" Content="{StaticResource Icon.Close}"
                        Command="{Binding DismissErrorCommand}" ToolTip="Kapat"
                        AutomationProperties.Name="Hata bildirimini kapat" Width="28" Height="28" FontSize="12" />
            </Grid>
        </Border>

        <!-- Ozet seridi (yalnizca sonuc gorunumunde) -->
        <views:SummaryStrip Grid.Row="3"
                            Visibility="{Binding IsResultsView, Converter={StaticResource Conv.BoolToVis}}" />

        <!-- Gezinme rail'i + icerik -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Width="176" Background="{DynamicResource Brush.Bg.Surface}"
                    BorderBrush="{DynamicResource Brush.Border.Default}" BorderThickness="0,0,1,0"
                    Visibility="{Binding IsResultsView, Converter={StaticResource Conv.BoolToVis}}">
                <StackPanel Margin="0,8">
                    <RadioButton Style="{StaticResource RadioButton.NavRail}" GroupName="Nav" Content="Ağaç"
                                 Tag="{StaticResource Icon.Tree}" ToolTip="Ağaç (Ctrl+1)"
                                 IsChecked="{Binding IsTreeActive, Mode=OneWay}"
                                 Command="{Binding NavigateCommand}" CommandParameter="1" />
                    <RadioButton Style="{StaticResource RadioButton.NavRail}" GroupName="Nav" Content="Harita"
                                 Tag="{StaticResource Icon.Treemap}" ToolTip="Harita (Ctrl+2)"
                                 IsChecked="{Binding IsTreemapActive, Mode=OneWay}"
                                 Command="{Binding NavigateCommand}" CommandParameter="2" />
                    <RadioButton Style="{StaticResource RadioButton.NavRail}" GroupName="Nav" Content="Uzantılar"
                                 Tag="{StaticResource Icon.Extensions}" ToolTip="Uzantılar (Ctrl+3)"
                                 IsChecked="{Binding IsExtensionsActive, Mode=OneWay}"
                                 Command="{Binding NavigateCommand}" CommandParameter="3" />
                    <RadioButton Style="{StaticResource RadioButton.NavRail}" GroupName="Nav" Content="En büyük 100"
                                 Tag="{StaticResource Icon.TopList}" ToolTip="En büyük 100 dosya (Ctrl+4)"
                                 IsChecked="{Binding IsTopFilesActive, Mode=OneWay}"
                                 Command="{Binding NavigateCommand}" CommandParameter="4" />
                    <RadioButton Style="{StaticResource RadioButton.NavRail}" GroupName="Nav" Content="Yaş dağılımı"
                                 Tag="{StaticResource Icon.Calendar}" ToolTip="Yaş dağılımı (Ctrl+5)"
                                 IsChecked="{Binding IsAgeActive, Mode=OneWay}"
                                 Command="{Binding NavigateCommand}" CommandParameter="5" />
                </StackPanel>
            </Border>

            <!-- Durum: Bos / Taraniyor / Sonuc -->
            <ContentControl Grid.Column="1" Content="{Binding}" IsTabStop="False">
                <ContentControl.Style>
                    <Style TargetType="ContentControl">
                        <Setter Property="ContentTemplate">
                            <Setter.Value>
                                <DataTemplate>
                                    <views:EmptyState />
                                </DataTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsScanningView}" Value="True">
                                <Setter Property="ContentTemplate">
                                    <Setter.Value>
                                        <DataTemplate>
                                            <views:ScanningState />
                                        </DataTemplate>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsResultsView}" Value="True">
                                <Setter Property="ContentTemplate">
                                    <Setter.Value>
                                        <DataTemplate>
                                            <ContentControl Content="{Binding}" IsTabStop="False">
                                                <ContentControl.Style>
                                                    <Style TargetType="ContentControl">
                                                        <Setter Property="ContentTemplate">
                                                            <Setter.Value>
                                                                <DataTemplate>
                                                                    <views:TreeDetailsView />
                                                                </DataTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding ActiveView}" Value="Treemap">
                                                                <Setter Property="ContentTemplate">
                                                                    <Setter.Value>
                                                                        <DataTemplate>
                                                                            <views:TreemapView />
                                                                        </DataTemplate>
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding ActiveView}" Value="Extensions">
                                                                <Setter Property="ContentTemplate">
                                                                    <Setter.Value>
                                                                        <DataTemplate>
                                                                            <views:ExtensionsView />
                                                                        </DataTemplate>
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding ActiveView}" Value="TopFiles">
                                                                <Setter Property="ContentTemplate">
                                                                    <Setter.Value>
                                                                        <DataTemplate>
                                                                            <views:TopFilesView />
                                                                        </DataTemplate>
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding ActiveView}" Value="Age">
                                                                <Setter Property="ContentTemplate">
                                                                    <Setter.Value>
                                                                        <DataTemplate>
                                                                            <views:AgeView />
                                                                        </DataTemplate>
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ContentControl.Style>
                                            </ContentControl>
                                        </DataTemplate>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ContentControl.Style>
            </ContentControl>
        </Grid>

        <!-- Durum cubugu -->
        <Border Grid.Row="5" Background="{DynamicResource Brush.Bg.Surface}"
                BorderBrush="{DynamicResource Brush.Border.Default}" BorderThickness="0,1,0,0" Padding="16,0" Height="28">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding StatusText}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center"
                           MaxWidth="360" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="1" Text="{Binding CurrentScanPath}" Style="{StaticResource Text.Mono}"
                           Foreground="{DynamicResource Brush.Text.Muted}" Margin="16,0" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Visibility="{Binding IsScanning, Converter={StaticResource Conv.BoolToVis}}" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                            Visibility="{Binding IsScanning, Converter={StaticResource Conv.BoolToVis}}">
                    <TextBlock Text="{Binding ScanSpeed}" Style="{StaticResource Text.Mono}"
                               Foreground="{DynamicResource Brush.Text.Secondary}" Margin="0,0,16,0" />
                    <TextBlock Text="{Binding ElapsedScanTime}" Style="{StaticResource Text.Mono}"
                               Foreground="{DynamicResource Brush.Text.Secondary}" Margin="0,0,16,0" />
                    <ProgressBar Width="120" IsIndeterminate="True" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
