<UserControl x:Class="AmberTree.Views.SummaryStrip"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False">
    <UserControl.Resources>
        <Style x:Key="Stat.Label" TargetType="TextBlock" BasedOn="{StaticResource Text.Muted}" />
        <Style x:Key="Stat.Value" TargetType="TextBlock" BasedOn="{StaticResource Text.Mono}">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="Unit.Radio" TargetType="RadioButton" BasedOn="{StaticResource RadioButton.Segment}" />
    </UserControl.Resources>

    <Border Background="{DynamicResource Brush.Bg.Surface}"
            BorderBrush="{DynamicResource Brush.Border.Default}" BorderThickness="0,0,0,1" Padding="16,8">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="150" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal">
                <StackPanel Margin="0,0,20,0">
                    <TextBlock Text="Toplam boyut" Style="{StaticResource Stat.Label}" />
                    <TextBlock Text="{Binding TotalSizeDisplay}" Style="{StaticResource Stat.Value}" />
                </StackPanel>
                <StackPanel Margin="0,0,20,0">
                    <TextBlock Text="Diskte" Style="{StaticResource Stat.Label}" />
                    <TextBlock Text="{Binding TotalAllocatedDisplay}" Style="{StaticResource Stat.Value}" />
                </StackPanel>
                <StackPanel Margin="0,0,20,0">
                    <TextBlock Text="Dosya" Style="{StaticResource Stat.Label}" />
                    <TextBlock Text="{Binding TotalFilesDisplay}" Style="{StaticResource Stat.Value}" />
                </StackPanel>
                <StackPanel Margin="0,0,20,0">
                    <TextBlock Text="Klasör" Style="{StaticResource Stat.Label}" />
                    <TextBlock Text="{Binding TotalFoldersDisplay}" Style="{StaticResource Stat.Value}" />
                </StackPanel>
                <StackPanel Margin="0,0,20,0">
                    <TextBlock Text="Süre" Style="{StaticResource Stat.Label}" />
                    <TextBlock Text="{Binding ScanDurationDisplay}" Style="{StaticResource Stat.Value}" />
                </StackPanel>
            </StackPanel>

            <!-- Disk doluluk -->
            <StackPanel Grid.Column="1" Margin="0,0,20,0" VerticalAlignment="Center"
                        ToolTip="Taranan sürücünün doluluk durumu">
                <Grid>
                    <TextBlock Style="{StaticResource Text.Caption}" TextTrimming="CharacterEllipsis">
                        <Run Text="Disk:" /> <Run Text="{Binding DriveUsedDisplay, Mode=OneWay}" FontFamily="{DynamicResource Font.Mono}" /> <Run Text="/" /> <Run Text="{Binding DriveTotalDisplay, Mode=OneWay}" FontFamily="{DynamicResource Font.Mono}" /> <Run Text="dolu" />
                    </TextBlock>
                    <TextBlock Style="{StaticResource Text.Caption}" HorizontalAlignment="Right">
                        <Run Text="{Binding DriveFreeDisplay, Mode=OneWay}" FontFamily="{DynamicResource Font.Mono}" /> <Run Text="boş" />
                    </TextBlock>
                </Grid>
                <ProgressBar Value="{Binding DriveUsedPercent, Mode=OneWay}" Height="6" MinHeight="6" Margin="0,6,0,0" />
            </StackPanel>

            <!-- Birim secici -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Birim" Style="{StaticResource Text.Muted}" VerticalAlignment="Center" Margin="0,0,8,0" />
                <Border Background="{DynamicResource Brush.Bg.Base}" BorderBrush="{DynamicResource Brush.Border.Default}"
                        BorderThickness="1" CornerRadius="6" Padding="2">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource Unit.Radio}" Content="Oto" GroupName="Unit"
                                     IsChecked="{Binding CurrentUnitMode, Converter={StaticResource Conv.EnumEq}, ConverterParameter=Auto, Mode=OneWay}"
                                     Command="{Binding SetUnitModeCommand}" CommandParameter="Auto" />
                        <RadioButton Style="{StaticResource Unit.Radio}" Content="MB" GroupName="Unit"
                                     IsChecked="{Binding CurrentUnitMode, Converter={StaticResource Conv.EnumEq}, ConverterParameter=MB, Mode=OneWay}"
                                     Command="{Binding SetUnitModeCommand}" CommandParameter="MB" />
                        <RadioButton Style="{StaticResource Unit.Radio}" Content="GB" GroupName="Unit"
                                     IsChecked="{Binding CurrentUnitMode, Converter={StaticResource Conv.EnumEq}, ConverterParameter=GB, Mode=OneWay}"
                                     Command="{Binding SetUnitModeCommand}" CommandParameter="GB" />
                        <RadioButton Style="{StaticResource Unit.Radio}" Content="Bayt" GroupName="Unit"
                                     IsChecked="{Binding CurrentUnitMode, Converter={StaticResource Conv.EnumEq}, ConverterParameter=Bytes, Mode=OneWay}"
                                     Command="{Binding SetUnitModeCommand}" CommandParameter="Bytes" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
