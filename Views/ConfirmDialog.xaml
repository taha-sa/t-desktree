<Window x:Class="AmberTree.Views.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        SizeToContent="WidthAndHeight" ShowInTaskbar="False"
        FontFamily="{DynamicResource Font.UI}" FontSize="13">
    <Grid Margin="16">
        <Border Background="{DynamicResource Brush.Bg.Elevated}"
                BorderBrush="{DynamicResource Brush.Border.Strong}"
                BorderThickness="1"
                CornerRadius="{StaticResource Radius.Card}"
                MinWidth="380" MaxWidth="480" Padding="24">
            <Border.Effect>
                <DropShadowEffect Color="{DynamicResource Color.Shadow}" BlurRadius="24" ShadowDepth="6" Opacity="0.45" />
            </Border.Effect>

            <StackPanel>
                <!-- Baslik ve Ikon -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border x:Name="IconBorder" Width="36" Height="36" CornerRadius="18"
                            Background="{DynamicResource Brush.Danger.Soft}"
                            VerticalAlignment="Center" Margin="0,0,14,0">
                        <TextBlock x:Name="IconGlyph" Text="{StaticResource Icon.Warning}"
                                   FontFamily="{DynamicResource Font.Icons}" FontSize="18"
                                   Foreground="{DynamicResource Brush.Danger}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <TextBlock Grid.Column="1" x:Name="TitleText" Text="Onay"
                               Style="{StaticResource Text.Subtitle}" VerticalAlignment="Center"
                               TextWrapping="Wrap" />
                </Grid>

                <!-- Mesaj -->
                <TextBlock x:Name="MessageText" Text="Devam etmek istiyor musunuz?"
                           Style="{StaticResource Text.Secondary}" TextWrapping="Wrap"
                           LineHeight="20" Margin="0,0,0,24" />

                <!-- Butonlar -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="CancelButton" Content="İptal" Style="{StaticResource Button.Secondary}"
                            MinWidth="88" Margin="0,0,10,0" IsCancel="True" Click="Cancel_Click" />
                    <Button x:Name="ConfirmButton" Content="Onayla" Style="{StaticResource Button.Primary}"
                            MinWidth="88" IsDefault="True" Click="Confirm_Click" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
