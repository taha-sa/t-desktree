<UserControl x:Class="AmberTree.Views.CommandBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False">
    <Border Background="{DynamicResource Brush.Bg.Base}"
            BorderBrush="{DynamicResource Brush.Border.Default}" BorderThickness="0,0,0,1" Padding="16,10">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="3*" MinWidth="140" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="2*" MinWidth="120" MaxWidth="280" />
            </Grid.ColumnDefinitions>

            <ComboBox Grid.Column="0" Width="150" ItemsSource="{Binding Drives}" SelectedItem="{Binding SelectedDrive}"
                      DisplayMemberPath="DisplayTitle" Margin="0,0,8,0"
                      IsEnabled="{Binding IsScanning, Converter={StaticResource Conv.Not}}"
                      ToolTip="Sürücü seç" AutomationProperties.Name="Sürücü seç" />

            <TextBox Grid.Column="1" x:Name="PathBox" Text="{Binding SelectedPath, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,0,8,0" FontFamily="{DynamicResource Font.Mono}" FontSize="12"
                     IsEnabled="{Binding IsScanning, Converter={StaticResource Conv.Not}}"
                     ToolTip="Taranacak sürücü ya da klasör yolu" AutomationProperties.Name="Taranacak yol">
                <TextBox.InputBindings>
                    <KeyBinding Key="Return" Command="{Binding StartScanCommand}" />
                </TextBox.InputBindings>
            </TextBox>

            <Button Grid.Column="2" Style="{StaticResource Button.Secondary}" Command="{Binding BrowseFolderCommand}"
                    Margin="0,0,8,0" AutomationProperties.Name="Klasör seç" ToolTip="Klasör seç">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{StaticResource Icon.FolderOpen}" FontFamily="{DynamicResource Font.Icons}" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock Text="Gözat" VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <Grid Grid.Column="3" Margin="0,0,8,0">
                <Button Style="{StaticResource Button.Primary}" Command="{Binding StartScanCommand}" MinWidth="96"
                        Visibility="{Binding IsScanning, Converter={StaticResource Conv.BoolToVisInv}}"
                        ToolTip="Taramayı başlat (F5)" AutomationProperties.Name="Taramayı başlat">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{StaticResource Icon.Play}" FontFamily="{DynamicResource Font.Icons}" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="Tara" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource Button.Danger}" Command="{Binding StopScanCommand}" MinWidth="96"
                        Visibility="{Binding IsScanning, Converter={StaticResource Conv.BoolToVis}}"
                        ToolTip="Taramayı durdur (Esc)" AutomationProperties.Name="Taramayı durdur">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{StaticResource Icon.Stop}" FontFamily="{DynamicResource Font.Icons}" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="Durdur" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>

            <Button Grid.Column="4" x:Name="ExportButton" Click="Export_Click" Margin="0,0,8,0"
                    IsEnabled="{Binding IsResultsView}" ToolTip="Sonuçları dışa aktar" AutomationProperties.Name="Dışa aktar">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{StaticResource Icon.Export}" FontFamily="{DynamicResource Font.Icons}" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock Text="Dışa aktar" VerticalAlignment="Center" />
                    <TextBlock Text="{StaticResource Icon.ChevronDown}" FontFamily="{DynamicResource Font.Icons}" FontSize="9" Margin="8,1,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <Button.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="CSV tablosu (.csv)" Icon="{StaticResource Icon.File}"
                                  Command="{Binding PlacementTarget.DataContext.ExportCsvCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        <MenuItem Header="JSON belgesi (.json)" Icon="{StaticResource Icon.File}"
                                  Command="{Binding PlacementTarget.DataContext.ExportJsonCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        <MenuItem Header="Metin raporu (.txt)" Icon="{StaticResource Icon.File}"
                                  Command="{Binding PlacementTarget.DataContext.ExportTxtCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                    </ContextMenu>
                </Button.ContextMenu>
            </Button>

            <Grid Grid.Column="5">
                <TextBox x:Name="SearchBox" Style="{StaticResource TextBox.Search}" Tag="Ara (Ctrl+F)"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Padding="32,4,32,4"
                         IsEnabled="{Binding IsResultsView}" AutomationProperties.Name="Dosya ve klasör ara" />
                <Button Style="{StaticResource Button.Icon}" Content="{StaticResource Icon.Close}" FontSize="11"
                        Width="24" Height="24" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0"
                        Command="{Binding ClearSearchCommand}" ToolTip="Aramayı temizle"
                        AutomationProperties.Name="Aramayı temizle"
                        Visibility="{Binding IsSearchActive, Converter={StaticResource Conv.BoolToVis}}" />
            </Grid>
        </Grid>
    </Border>
</UserControl>
