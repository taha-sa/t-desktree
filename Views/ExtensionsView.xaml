<UserControl x:Class="AmberTree.Views.ExtensionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:loc="clr-namespace:AmberTree.Localization"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False">
    <Grid Margin="0">
        <DataGrid ItemsSource="{Binding Extensions}" AutomationProperties.Name="{loc:Text ExtensionStatistics}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="{loc:Text Extension}" Binding="{Binding Extension}" SortMemberPath="Extension" Width="110"
                                    ElementStyle="{StaticResource Grid.Text}" />
                <DataGridTextColumn Header="{loc:Text Description}" Binding="{Binding Description}" Width="*" MinWidth="120"
                                    ElementStyle="{StaticResource Grid.Text}" />
                <DataGridTextColumn Header="{loc:Text File}" Binding="{Binding FileCount, StringFormat={}{0:N0}}" SortMemberPath="FileCount" Width="90"
                                    HeaderStyle="{StaticResource Grid.HeaderRight}" ElementStyle="{StaticResource Grid.Num}" />
                <DataGridTextColumn Header="{loc:Text Size}" Binding="{Binding TotalSizeDisplay}" SortMemberPath="TotalSize" Width="100"
                                    HeaderStyle="{StaticResource Grid.HeaderRight}" ElementStyle="{StaticResource Grid.Num}" />
                <DataGridTextColumn Header="{loc:Text OnDisk}" Binding="{Binding AllocatedSizeDisplay}" SortMemberPath="AllocatedSize" Width="100"
                                    HeaderStyle="{StaticResource Grid.HeaderRight}" ElementStyle="{StaticResource Grid.Num}" />
                <DataGridTemplateColumn Header="{loc:Text TotalShare}" SortMemberPath="PercentOfTotal" Width="*" MinWidth="140">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="52" />
                                </Grid.ColumnDefinitions>
                                <Grid Height="6" VerticalAlignment="Center" Margin="0,0,8,0">
                                    <Border Background="{DynamicResource Brush.Bg.Subtle}" CornerRadius="3" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="{Binding PercentOfTotal, Converter={StaticResource Conv.PctToStar}, ConverterParameter=fill}" />
                                            <ColumnDefinition Width="{Binding PercentOfTotal, Converter={StaticResource Conv.PctToStar}, ConverterParameter=rest}" />
                                        </Grid.ColumnDefinitions>
                                        <Border Style="{StaticResource Bar.Fill}" />
                                    </Grid>
                                </Grid>
                                <TextBlock Grid.Column="1" Text="{Binding PercentDisplay}" Style="{StaticResource Grid.Num}" />
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
