<UserControl x:Class="AmberTree.Views.TitleBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
             Height="40" Focusable="False">
    <Border Background="{DynamicResource Brush.Bg.Surface}"
            BorderBrush="{DynamicResource Brush.Border.Default}" BorderThickness="0,0,0,1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                <Viewbox Width="22" Height="22" Stretch="Uniform" UseLayoutRounding="False" SnapsToDevicePixels="False">
                    <Canvas Width="256" Height="256">
                        <!-- Squircle çerçeve -->
                        <Border Width="256" Height="256" CornerRadius="56" Background="{DynamicResource Brush.Border.Default}" />
                        <Border Canvas.Left="3" Canvas.Top="3" Width="250" Height="250" CornerRadius="53" Background="{DynamicResource Brush.Bg.Surface}" />
                        <!-- Treemap Veri Blokları (Dallar) -->
                        <Border Canvas.Left="38" Canvas.Top="84" Width="64" Height="63" CornerRadius="10" Background="{DynamicResource Brush.Cat.Image}" />
                        <Border Canvas.Left="38" Canvas.Top="155" Width="64" Height="63" CornerRadius="10" Background="{DynamicResource Brush.Cat.Video}" />
                        <Border Canvas.Left="154" Canvas.Top="84" Width="64" Height="63" CornerRadius="10" Background="{DynamicResource Brush.Cat.Audio}" />
                        <Border Canvas.Left="154" Canvas.Top="155" Width="64" Height="63" CornerRadius="10" Background="{DynamicResource Brush.Warning}" />
                        <!-- T-Monogram (Gövde & Çatı) -->
                        <Border Canvas.Left="38" Canvas.Top="38" Width="180" Height="38" CornerRadius="10" Background="{DynamicResource Brush.Accent}" />
                        <Border Canvas.Left="110" Canvas.Top="68" Width="36" Height="150" CornerRadius="0,0,10,10" Background="{DynamicResource Brush.Accent}" />
                    </Canvas>
                </Viewbox>
                <TextBlock Text="T-DeskTree" Style="{StaticResource Text.BodyStrong}" Margin="10,0,0,0"
                           VerticalAlignment="Center" />
                <TextBlock Text="Disk alanı analizi" Style="{StaticResource Text.Muted}" Margin="10,1,0,0"
                           VerticalAlignment="Center" />
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button Style="{StaticResource Button.TitleBar}" Width="46" Height="40"
                        Command="{Binding RestartAsAdminCommand}" ToolTip="Yönetici olarak yeniden başlat"
                        AutomationProperties.Name="Yönetici olarak yeniden başlat" FontSize="13"
                        Visibility="{Binding IsRunningAsAdmin, Converter={StaticResource Conv.BoolToVisInv}}">
                    <TextBlock Text="{StaticResource Icon.Shield}" Foreground="{DynamicResource Brush.Warning}" />
                </Button>
                <Button x:Name="ThemeButton" Style="{StaticResource Button.TitleBar}" Width="46" Height="40"
                        Command="{Binding ToggleThemeCommand}" ToolTip="Temayı değiştir"
                        AutomationProperties.Name="Temayı değiştir" FontSize="14">
                    <Button.Content>
                        <TextBlock x:Name="ThemeGlyph" Text="{StaticResource Icon.Sun}" />
                    </Button.Content>
                </Button>
                <Button Style="{StaticResource Button.TitleBar}" Height="40" Click="Minimize_Click"
                        Content="{StaticResource Icon.Minimize}" ToolTip="Simge durumuna küçült"
                        AutomationProperties.Name="Simge durumuna küçült" />
                <Button x:Name="MaxButton" Style="{StaticResource Button.TitleBar}" Height="40" Click="Maximize_Click"
                        Content="{StaticResource Icon.Maximize}" ToolTip="Ekranı kapla"
                        AutomationProperties.Name="Ekranı kapla" />
                <Button Style="{StaticResource Button.TitleBarClose}" Height="40" Click="Close_Click"
                        Content="{StaticResource Icon.Close}" ToolTip="Kapat"
                        AutomationProperties.Name="Kapat" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
