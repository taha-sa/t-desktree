<UserControl x:Class="AmberTree.Views.TopFilesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:loc="clr-namespace:AmberTree.Localization"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False">
    <UserControl.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.3" To="1.0" Duration="0:0:0.18">
                        <DoubleAnimation.EasingFunction>
                            <QuadraticEase EasingMode="EaseOut" />
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>
    <UserControl.InputBindings>
        <KeyBinding Key="Delete" Command="{Binding RecycleCommand}" CommandParameter="{Binding SelectedItem, ElementName=Grid}" />
        <KeyBinding Key="Delete" Modifiers="Shift" Command="{Binding DeletePermanentCommand}" CommandParameter="{Binding SelectedItem, ElementName=Grid}" />
    </UserControl.InputBindings>
    <Grid>
        <DataGrid x:Name="Grid" ItemsSource="{Binding TopFiles}" AutomationProperties.Name="{loc:Text LargestFiles}">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                    <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                    <Setter Property="ContextMenu" Value="{StaticResource TopFileContextMenu}" />
                    <Setter Property="ToolTip" Value="{Binding FullPath}" />
                    <EventSetter Event="PreviewMouseRightButtonDown" Handler="Row_PreviewMouseRightButtonDown" />
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="#" Binding="{Binding Rank}" Width="56"
                                    HeaderStyle="{StaticResource Grid.HeaderRight}" ElementStyle="{StaticResource Grid.Num}" />
                <DataGridTemplateColumn Header="{loc:Text Name}" SortMemberPath="Name" Width="*" MinWidth="140">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Left" Text="{StaticResource Icon.File}" Style="{StaticResource Text.Icon}"
                                           FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Name}" Style="{StaticResource Grid.Text}" />
                            </DockPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="{loc:Text Location}" Binding="{Binding DirectoryPath}" Width="1.4*" MinWidth="140"
                                    ElementStyle="{StaticResource Grid.Path}" />
                <DataGridTextColumn Header="{loc:Text Size}" Binding="{Binding SizeDisplay}" SortMemberPath="Size" Width="96"
                                    HeaderStyle="{StaticResource Grid.HeaderRight}" ElementStyle="{StaticResource Grid.Num}" />
                <DataGridTextColumn Header="{loc:Text OnDisk}" Binding="{Binding AllocatedSizeDisplay}" SortMemberPath="AllocatedSize" Width="96"
                                    HeaderStyle="{StaticResource Grid.HeaderRight}" ElementStyle="{StaticResource Grid.Num}" />
                <DataGridTextColumn Header="{loc:Text LastModified}" Binding="{Binding LastModified, StringFormat={loc:Text DateFormat}}" SortMemberPath="LastModified" Width="136"
                                    HeaderStyle="{StaticResource Grid.HeaderRight}" ElementStyle="{StaticResource Grid.Num}" />
                <DataGridTemplateColumn Header="{loc:Text Share}" SortMemberPath="PercentOfTotal" Width="120" MinWidth="90">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="52" />
                                </Grid.ColumnDefinitions>
                                <Grid Height="6" VerticalAlignment="Center" Margin="0,0,8,0">
                                    <Border Background="{DynamicResource Brush.Bg.Subtle}" CornerRadius="3" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="{Binding PercentOfTotal, Converter={StaticResource Conv.PctToStar}, ConverterParameter=fill}" />
                                            <ColumnDefinition Width="{Binding PercentOfTotal, Converter={StaticResource Conv.PctToStar}, ConverterParameter=rest}" />
                                        </Grid.ColumnDefinitions>
                                        <Border Style="{StaticResource Bar.Fill}" />
                                    </Grid>
                                </Grid>
                                <TextBlock Grid.Column="1" Text="{Binding PercentDisplay}" Style="{StaticResource Grid.Num}" />
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
