<UserControl x:Class="AmberTree.Views.EmptyState"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:loc="clr-namespace:AmberTree.Localization"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="420" Margin="24">
            <Border Width="72" Height="72" CornerRadius="36" Background="{DynamicResource Brush.Accent.Soft}"
                    HorizontalAlignment="Center">
                <TextBlock Text="{StaticResource Icon.Drive}" FontFamily="{DynamicResource Font.Icons}" FontSize="32"
                           Foreground="{DynamicResource Brush.Accent}" HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
            </Border>
            <TextBlock Text="{loc:Text ReadyToAnalyze}" Style="{StaticResource Text.Title}" Margin="0,24,0,0"
                       HorizontalAlignment="Center" TextAlignment="Center" />
            <TextBlock Text="{loc:Text ChooseAndScan}" Style="{StaticResource Text.Secondary}"
                       Margin="0,8,0,0" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
            <Button Style="{StaticResource Button.Primary}" Command="{Binding StartScanCommand}" Margin="0,24,0,0"
                    HorizontalAlignment="Center" MinWidth="180" MinHeight="40" FontSize="14"
                    AutomationProperties.Name="{loc:Text StartScan}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{StaticResource Icon.Play}" FontFamily="{DynamicResource Font.Icons}" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center" />
                    <TextBlock Text="{loc:Text StartScan}" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <TextBlock Text="{loc:Text ScanShortcut}" Style="{StaticResource Text.Muted}" Margin="0,8,0,0" HorizontalAlignment="Center" />

            <Border Style="{StaticResource Border.Card}" Margin="0,32,0,0" Padding="12"
                    Visibility="{Binding HasLastScannedPath, Converter={StaticResource Conv.BoolToVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{loc:Text LastScan}" Style="{StaticResource Text.Muted}" />
                        <TextBlock Text="{Binding LastScannedPath}" Style="{StaticResource Text.Mono}" Margin="0,2,0,0"
                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding LastScannedPath}" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="{loc:Text ScanAgain}" Margin="12,0,0,0" Click="RescanLast_Click"
                            AutomationProperties.Name="{loc:Text ScanLastPath}" />
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
