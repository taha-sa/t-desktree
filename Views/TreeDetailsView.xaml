<UserControl x:Class="AmberTree.Views.TreeDetailsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:loc="clr-namespace:AmberTree.Localization"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:AmberTree.Views"
             xmlns:models="clr-namespace:AmberTree.Models"
             Focusable="False">
    <UserControl.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.3" To="1.0" Duration="0:0:0.18">
                        <DoubleAnimation.EasingFunction>
                            <QuadraticEase EasingMode="EaseOut" />
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>
    <UserControl.Resources>
        <views:TreeColumns x:Key="Cols" />

        <Style x:Key="Head.Button" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
            <Setter Property="FontFamily" Value="{DynamicResource Font.UI}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Bg.Elevated}" />
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Bg.Subtle}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Head.ButtonRight" TargetType="Button" BasedOn="{StaticResource Head.Button}">
            <Setter Property="HorizontalContentAlignment" Value="Right" />
        </Style>
        <Style x:Key="Head.SortArrow" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="Cell.Num" TargetType="TextBlock" BasedOn="{StaticResource Text.Mono}">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="8,0" />
        </Style>
        <Style x:Key="Cell.NumDir" TargetType="TextBlock" BasedOn="{StaticResource Cell.Num}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDirectory}" Value="False">
                    <Setter Property="Visibility" Value="Hidden" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Splitter.Handle" TargetType="Thumb">
            <Setter Property="Width" Value="8" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Margin" Value="-4,6,0,6" />
            <Setter Property="Cursor" Value="SizeWE" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="Transparent">
                            <Border Width="1" HorizontalAlignment="Center" Background="{DynamicResource Brush.Border.Strong}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <HierarchicalDataTemplate DataType="{x:Type models:FsItem}" ItemsSource="{Binding Children}">
            <Grid ToolTip="{Binding FullPath}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="120" />
                    <ColumnDefinition Width="{Binding Size, Source={StaticResource Cols}}" />
                    <ColumnDefinition Width="{Binding Allocated, Source={StaticResource Cols}}" />
                    <ColumnDefinition Width="{Binding Percent, Source={StaticResource Cols}}" />
                    <ColumnDefinition Width="{Binding Files, Source={StaticResource Cols}}" />
                    <ColumnDefinition Width="{Binding Folders, Source={StaticResource Cols}}" />
                    <ColumnDefinition Width="{Binding Modified, Source={StaticResource Cols}}" />
                    <ColumnDefinition Width="{Binding Attr, Source={StaticResource Cols}}" />
                </Grid.ColumnDefinitions>

                <!-- Ad: girinti + genisletme oku + hiyerarsik renkli klasor ikonu + ad -->
                <DockPanel Margin="{Binding Converter={StaticResource Conv.Depth}}" LastChildFill="True">
                    <ToggleButton DockPanel.Dock="Left" Width="20" Height="20" Focusable="False" ClickMode="Press" VerticalAlignment="Center"
                                  IsChecked="{Binding IsExpanded, Mode=TwoWay}"
                                  Visibility="{Binding IsDirectory, Converter={StaticResource Conv.BoolToVis}}"
                                  Style="{StaticResource TreeView.Expander}" />
                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource Fs.Icon}" Width="22" Margin="2,0,6,0" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Name}" Style="{StaticResource Fs.Name}" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                </DockPanel>

                <TextBlock Grid.Column="1" Text="{Binding SizeDisplay}" Style="{StaticResource Cell.Num}" />
                <TextBlock Grid.Column="2" Text="{Binding AllocatedSizeDisplay}" Style="{StaticResource Cell.Num}"
                           Foreground="{DynamicResource Brush.Text.Secondary}" />

                <!-- Ust %'si: oransal bar + yuzde -->
                <Grid Grid.Column="3" Margin="8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="46" />
                    </Grid.ColumnDefinitions>
                    <Grid Height="6" VerticalAlignment="Center" Margin="0,0,8,0">
                        <Border Background="{DynamicResource Brush.Bg.Subtle}" CornerRadius="3" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="{Binding PercentOfParent, Converter={StaticResource Conv.PctToStar}, ConverterParameter=fill}" />
                                <ColumnDefinition Width="{Binding PercentOfParent, Converter={StaticResource Conv.PctToStar}, ConverterParameter=rest}" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource Fs.BarFill}" />
                        </Grid>
                    </Grid>
                    <TextBlock Grid.Column="1" Text="{Binding PercentOfParentDisplay}" Style="{StaticResource Text.Mono}"
                               HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>

                <TextBlock Grid.Column="4" Text="{Binding FileCount, StringFormat={}{0:N0}}" Style="{StaticResource Cell.NumDir}" />
                <TextBlock Grid.Column="5" Text="{Binding FolderCount, StringFormat={}{0:N0}}" Style="{StaticResource Cell.NumDir}" />
                <TextBlock Grid.Column="6" Text="{Binding LastModified, StringFormat={loc:Text DateFormat}}" Style="{StaticResource Cell.Num}"
                           Foreground="{DynamicResource Brush.Text.Secondary}" />
                <TextBlock Grid.Column="7" Text="{Binding AttributesDisplay}" Style="{StaticResource Cell.Num}"
                           Foreground="{DynamicResource Brush.Text.Muted}" />
            </Grid>
        </HierarchicalDataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Tiklanabilir klasik siralama basliklari + suruklenebilir kolon sinirlari -->
        <Border Grid.Row="0" Background="{DynamicResource Brush.Bg.Surface}"
                BorderBrush="{DynamicResource Brush.Border.Default}" BorderThickness="0,0,0,1"
                Padding="8,0,12,0" Height="34">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="120" />
                    <ColumnDefinition Width="{Binding Size, Source={StaticResource Cols}}" />
                    <ColumnDefinition Width="{Binding Allocated, Source={StaticResource Cols}}" />
                    <ColumnDefinition Width="{Binding Percent, Source={StaticResource Cols}}" />
                    <ColumnDefinition Width="{Binding Files, Source={StaticResource Cols}}" />
                    <ColumnDefinition Width="{Binding Folders, Source={StaticResource Cols}}" />
                    <ColumnDefinition Width="{Binding Modified, Source={StaticResource Cols}}" />
                    <ColumnDefinition Width="{Binding Attr, Source={StaticResource Cols}}" />
                </Grid.ColumnDefinitions>

                <Button Style="{StaticResource Head.Button}" Padding="50,0,8,0"
                        Command="{Binding SortByColumnCommand}" CommandParameter="Name">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{loc:Text Name}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding NameSortIndicator}" Style="{StaticResource Head.SortArrow}" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="1" Style="{StaticResource Head.ButtonRight}"
                        Command="{Binding SortByColumnCommand}" CommandParameter="Size">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{loc:Text Size}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding SizeSortIndicator}" Style="{StaticResource Head.SortArrow}" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="2" Style="{StaticResource Head.ButtonRight}" ToolTip="{loc:Text AllocatedHelp}"
                        Command="{Binding SortByColumnCommand}" CommandParameter="Allocated">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{loc:Text OnDisk}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding AllocatedSortIndicator}" Style="{StaticResource Head.SortArrow}" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="3" Style="{StaticResource Head.Button}"
                        Command="{Binding SortByColumnCommand}" CommandParameter="Percent">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{loc:Text ParentPercent}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding PercentSortIndicator}" Style="{StaticResource Head.SortArrow}" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="4" Style="{StaticResource Head.ButtonRight}"
                        Command="{Binding SortByColumnCommand}" CommandParameter="Files">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{loc:Text File}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding FilesSortIndicator}" Style="{StaticResource Head.SortArrow}" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="5" Style="{StaticResource Head.ButtonRight}"
                        Command="{Binding SortByColumnCommand}" CommandParameter="Folders">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{loc:Text FolderDuplicate}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding FoldersSortIndicator}" Style="{StaticResource Head.SortArrow}" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="6" Style="{StaticResource Head.ButtonRight}"
                        Command="{Binding SortByColumnCommand}" CommandParameter="Modified">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{loc:Text LastModified}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding ModifiedSortIndicator}" Style="{StaticResource Head.SortArrow}" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="7" Style="{StaticResource Head.ButtonRight}"
                        Command="{Binding SortByColumnCommand}" CommandParameter="Attributes">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{loc:Text Attributes}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding AttrSortIndicator}" Style="{StaticResource Head.SortArrow}" />
                    </StackPanel>
                </Button>

                <Thumb Grid.Column="1" Tag="Size" Style="{StaticResource Splitter.Handle}" DragDelta="Splitter_DragDelta" />
                <Thumb Grid.Column="2" Tag="Allocated" Style="{StaticResource Splitter.Handle}" DragDelta="Splitter_DragDelta" />
                <Thumb Grid.Column="3" Tag="Percent" Style="{StaticResource Splitter.Handle}" DragDelta="Splitter_DragDelta" />
                <Thumb Grid.Column="4" Tag="Files" Style="{StaticResource Splitter.Handle}" DragDelta="Splitter_DragDelta" />
                <Thumb Grid.Column="5" Tag="Folders" Style="{StaticResource Splitter.Handle}" DragDelta="Splitter_DragDelta" />
                <Thumb Grid.Column="6" Tag="Modified" Style="{StaticResource Splitter.Handle}" DragDelta="Splitter_DragDelta" />
                <Thumb Grid.Column="7" Tag="Attr" Style="{StaticResource Splitter.Handle}" DragDelta="Splitter_DragDelta" />
            </Grid>
        </Border>

        <TreeView x:Name="Tree" Grid.Row="1" ItemsSource="{Binding RootCollection}"
                  Padding="8,4,0,4"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Visible"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling"
                  VirtualizingPanel.ScrollUnit="Pixel"
                  SelectedItemChanged="Tree_SelectedItemChanged"
                  PreviewMouseRightButtonDown="Tree_PreviewMouseRightButtonDown">
            <TreeView.ItemContainerStyle>
                <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                    <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                    <Setter Property="Visibility" Value="{Binding IsFilteredOut, Converter={StaticResource Conv.FilteredToVis}}" />
                    <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=TreeView}}" />
                    <Setter Property="ContextMenu" Value="{StaticResource ItemContextMenu}" />
                </Style>
            </TreeView.ItemContainerStyle>
        </TreeView>

        <!-- Arama sonucu yok -->
        <Border Grid.Row="1" Background="{DynamicResource Brush.Bg.Base}"
                Visibility="{Binding ShowNoSearchResults, Converter={StaticResource Conv.BoolToVis}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="{StaticResource Icon.Search}" Style="{StaticResource Text.Icon}" FontSize="32"
                           Foreground="{DynamicResource Brush.Text.Muted}" HorizontalAlignment="Center" />
                <TextBlock Style="{StaticResource Text.Subtitle}" Margin="0,16,0,0" HorizontalAlignment="Center">
                    <Run Text="{loc:Text QuoteStart}" /><Run Text="{Binding SearchText, Mode=OneWay}" /><Run Text="{loc:Text SearchNoResults}" />
                </TextBlock>
                <TextBlock Text="{loc:Text SearchNoResultsHelp}" Style="{StaticResource Text.Secondary}"
                           Margin="0,4,0,16" HorizontalAlignment="Center" />
                <Button Content="{loc:Text ClearSearchDuplicate}" Command="{Binding ClearSearchCommand}" HorizontalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
