<UserControl x:Class="AmberTree.Views.UpdateBanner"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False">
    <!-- Ince afiş: başlık çubuğunun altında, 150 ms aşağı kayarak açılır (kod arkasında). -->
    <Border x:Name="Root" Visibility="Collapsed" ClipToBounds="True"
            AutomationProperties.LiveSetting="Polite"
            Background="{DynamicResource Brush.Accent.Soft}"
            BorderBrush="{DynamicResource Brush.Border.Default}" BorderThickness="0,0,0,1">
        <Border.LayoutTransform>
            <ScaleTransform x:Name="Slide" ScaleY="0" />
        </Border.LayoutTransform>
        <StackPanel>
            <Grid Margin="16,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Ellipse Width="8" Height="8" Fill="{DynamicResource Brush.Accent}" VerticalAlignment="Center" Margin="0,0,12,0" />

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" Style="{StaticResource Text.BodyStrong}" VerticalAlignment="Center" />
                    <Button Content="Notlar" Style="{StaticResource Button.Ghost}" Margin="12,0,0,0" Padding="8,2"
                            Command="{Binding ToggleNotesCommand}"
                            Visibility="{Binding HasNotes, Converter={StaticResource Conv.BoolToVis}}"
                            AutomationProperties.Name="Sürüm notlarını göster veya gizle" />
                    <TextBlock Text="{Binding Error}" Style="{StaticResource Text.Secondary}" Foreground="{DynamicResource Brush.Danger}"
                               TextWrapping="Wrap" MaxWidth="420"
                               Margin="12,0,0,0" VerticalAlignment="Center"
                               Visibility="{Binding Failed, Converter={StaticResource Conv.BoolToVis}}" />
                </StackPanel>

                <!-- Normal durum: Güncelle / Sonra / Bu sürümü atla -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                            Visibility="{Binding NotDownloading, Converter={StaticResource Conv.BoolToVis}}">
                    <Button Content="Bu sürümü atla" Style="{StaticResource Button.Ghost}" Command="{Binding SkipCommand}"
                            Foreground="{DynamicResource Brush.Text.Muted}" Margin="0,0,4,0"
                            AutomationProperties.Name="Bu sürümü atla" />
                    <Button Content="Sonra" Style="{StaticResource Button.Ghost}" Command="{Binding LaterCommand}" Margin="0,0,8,0"
                            AutomationProperties.Name="Güncellemeyi sonra hatırlat" />
                    <Button Content="Güncelle" Style="{StaticResource Button.Primary}" Command="{Binding UpdateCommand}"
                            AutomationProperties.Name="Güncellemeyi indir ve kur" />
                </StackPanel>

                <!-- İndirme durumu: ilerleme çubuğu + İptal -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                            Visibility="{Binding ShowProgress, Converter={StaticResource Conv.BoolToVis}}">
                    <ProgressBar Width="160" Height="4" Minimum="0" Maximum="100" Value="{Binding Progress}" BorderThickness="0"
                                 Foreground="{DynamicResource Brush.Accent}" Background="{DynamicResource Brush.Bg.Subtle}"
                                 AutomationProperties.Name="Güncelleme indiriliyor" />
                    <TextBlock Text="{Binding ProgressText}" Style="{StaticResource Text.Secondary}" Margin="10,0,10,0" VerticalAlignment="Center" />
                    <Button Content="İptal" Style="{StaticResource Button.Ghost}" Command="{Binding CancelCommand}"
                            AutomationProperties.Name="Güncelleme indirmesini iptal et" />
                </StackPanel>

                <!-- Yeniden başlatılıyor: belirsiz ilerleme -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                            Visibility="{Binding Launching, Converter={StaticResource Conv.BoolToVis}}">
                    <ProgressBar Width="160" Height="4" IsIndeterminate="True" BorderThickness="0"
                                 Foreground="{DynamicResource Brush.Accent}" Background="{DynamicResource Brush.Bg.Subtle}"
                                 AutomationProperties.Name="Uygulama yeniden başlatılıyor" />
                    <TextBlock Text="Yeniden başlatılıyor…" Style="{StaticResource Text.Secondary}" Margin="10,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>

            <!-- Notlar (açılır bölüm) -->
            <Border Background="{DynamicResource Brush.Bg.Elevated}" BorderBrush="{DynamicResource Brush.Border.Default}"
                    BorderThickness="0,1,0,0" Padding="40,8,16,8"
                    Visibility="{Binding NotesOpen, Converter={StaticResource Conv.BoolToVis}}">
                <ScrollViewer MaxHeight="120" VerticalScrollBarVisibility="Auto">
                    <TextBlock Text="{Binding Notes}" Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" />
                </ScrollViewer>
            </Border>
        </StackPanel>
    </Border>
</UserControl>
