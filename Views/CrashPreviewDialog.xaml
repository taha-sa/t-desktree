<Window x:Class="AmberTree.Views.CrashPreviewDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:loc="clr-namespace:AmberTree.Localization"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hata raporu" Width="700" Height="560" MinWidth="480" MinHeight="380"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource Brush.Bg.Elevated}" FontFamily="{DynamicResource Font.UI}">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock x:Name="Heading" Style="{StaticResource Text.Subtitle}" TextWrapping="Wrap" />
        <TextBlock Grid.Row="1" Margin="0,8,0,12" Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" Text="{loc:Text ReportHelp}" />
        <TextBox x:Name="Preview" Grid.Row="2" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="{DynamicResource Brush.Bg.Surface}" Foreground="{DynamicResource Brush.Text.Secondary}" BorderBrush="{DynamicResource Brush.Border.Default}" Padding="10" />
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="{loc:Text Close}" Style="{StaticResource Button.Secondary}" IsCancel="True" Click="Close_Click" Margin="0,0,8,0" />
            <Button Content="{loc:Text Copy}" Style="{StaticResource Button.Secondary}" Click="Copy_Click" Margin="0,0,8,0" />
            <Button Content="{loc:Text SubmitReport}" Style="{StaticResource Button.Primary}" IsDefault="True" Click="Send_Click" />
        </StackPanel>
    </Grid>
</Window>
