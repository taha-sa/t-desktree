<Window x:Class="AmberTree.Views.AboutDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        SizeToContent="WidthAndHeight" ShowInTaskbar="False"
        FontFamily="{DynamicResource Font.UI}" FontSize="13">
    <Grid Margin="16">
        <Border Background="{DynamicResource Brush.Bg.Elevated}"
                BorderBrush="{DynamicResource Brush.Border.Strong}"
                BorderThickness="1"
                CornerRadius="{StaticResource Radius.Card}"
                MinWidth="380" MaxWidth="440" Padding="28,24">
            <Border.Effect>
                <DropShadowEffect Color="{DynamicResource Color.Shadow}" BlurRadius="24" ShadowDepth="6" Opacity="0.45" />
            </Border.Effect>

            <StackPanel>
                <!-- Baslik Alani -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Logo -->
                    <Viewbox Width="32" Height="32" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,12,0">
                        <Canvas Width="256" Height="256">
                            <Border Width="256" Height="256" CornerRadius="56" Background="{DynamicResource Brush.Border.Default}" />
                            <Border Canvas.Left="3" Canvas.Top="3" Width="250" Height="250" CornerRadius="53" Background="{DynamicResource Brush.Bg.Surface}" />
                            <Border Canvas.Left="30" Canvas.Top="30" Width="92" Height="196" CornerRadius="10" Background="{DynamicResource Brush.Accent}" />
                            <Border Canvas.Left="138" Canvas.Top="30" Width="88" Height="90" CornerRadius="10" Background="{DynamicResource Brush.Cat.Video}" />
                            <Border Canvas.Left="138" Canvas.Top="136" Width="88" Height="90" CornerRadius="10" Background="{DynamicResource Brush.Cat.Image}" />
                        </Canvas>
                    </Viewbox>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="AmberTree" Style="{StaticResource Text.Title}" FontSize="18" />
                        <TextBlock Text="Disk alanı analizi" Style="{StaticResource Text.Muted}" FontSize="12" Margin="0,1,0,0" />
                    </StackPanel>

                    <!-- Kapat Ikonu -->
                    <Button Grid.Column="2" Style="{StaticResource Button.Icon}" Content="{StaticResource Icon.Close}"
                            Width="28" Height="28" FontSize="11" Click="Close_Click" ToolTip="Kapat"
                            AutomationProperties.Name="Kapat" VerticalAlignment="Top" Margin="8,0,-8,0" />
                </Grid>

                <!-- Ayirici cizgi -->
                <Border Height="1" Background="{DynamicResource Brush.Border.Default}" Margin="0,0,0,16" />

                <!-- Kart Bilgileri -->
                <Border Background="{DynamicResource Brush.Bg.Surface}"
                        BorderBrush="{DynamicResource Brush.Border.Default}"
                        BorderThickness="1" CornerRadius="{StaticResource Radius.Control}"
                        Padding="16,14" Margin="0,0,0,16">
                    <StackPanel>
                        <!-- Instagram -->
                        <TextBlock Style="{StaticResource Text.Body}" Margin="0,0,0,10">
                            <Run Text="İnstagram: " Foreground="{DynamicResource Brush.Text.Secondary}" FontWeight="SemiBold" />
                            <Hyperlink NavigateUri="https://www.instagram.com/tdesk.stuido" RequestNavigate="Hyperlink_RequestNavigate"
                                       Foreground="{DynamicResource Brush.Accent}" TextDecorations="None"
                                       ToolTip="Instagram profilini aç: @tdesk.stuido">
                                <Run Text="tdesk.stuido" FontWeight="Bold" />
                            </Hyperlink>
                        </TextBlock>

                        <Border Height="1" Background="{DynamicResource Brush.Border.Default}" Margin="0,0,0,10" />

                        <!-- Imza (Cok kucuk) -->
                        <TextBlock Style="{StaticResource Text.Muted}" FontSize="9.5" FontStyle="Italic">
                            <Run Text="Signature: " Foreground="{DynamicResource Brush.Text.Muted}" />
                            <Run Text="Taha Şaprak" Foreground="{DynamicResource Brush.Text.Secondary}" FontWeight="Normal" />
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- Kapat Butonu -->
                <Button Content="Kapat" Style="{StaticResource Button.Secondary}"
                        MinWidth="96" HorizontalAlignment="Right" IsCancel="True" Click="Close_Click" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
