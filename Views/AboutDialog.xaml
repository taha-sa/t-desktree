<Window x:Class="AmberTree.Views.AboutDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:loc="clr-namespace:AmberTree.Localization"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Width="472" Height="600" ShowInTaskbar="False" Icon="/T-DeskTree;component/app.ico"
        FontFamily="{DynamicResource Font.UI}" FontSize="13">
    <Grid Margin="16">
        <Border Background="{DynamicResource Brush.Bg.Elevated}"
                BorderBrush="{DynamicResource Brush.Border.Strong}"
                BorderThickness="1"
                CornerRadius="16"
                MinWidth="380" MaxWidth="440" Padding="28,24">
            <Border.Effect>
                <DropShadowEffect Color="{DynamicResource Color.Shadow}" BlurRadius="24" ShadowDepth="6" Opacity="0.45" />
            </Border.Effect>

            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <!-- Baslik Alani -->
                <Grid Margin="0,0,0,16">
                    <StackPanel HorizontalAlignment="Center">
                        <Image Source="/T-DeskTree;component/Assets/logo.png" Width="64" Height="64" AutomationProperties.Name="T-DeskTree" />
                        <TextBlock Text="T-DeskTree" Style="{StaticResource Text.Title}" HorizontalAlignment="Center" Margin="0,8,0,0" />
                        <TextBlock x:Name="VersionText" Style="{StaticResource Text.Caption}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                        <Border Background="{DynamicResource Brush.Success.Soft}" CornerRadius="6" Padding="8,4" HorizontalAlignment="Center" Margin="0,8,0,0">
                            <TextBlock Text="{loc:Text DiskAnalysis}" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.Text.Primary}" />
                        </Border>
                    </StackPanel>
                    <Button Style="{StaticResource Button.Icon}" Content="{StaticResource Icon.Close}"
                            Width="28" Height="28" FontSize="11" Click="Close_Click" ToolTip="{loc:Text Close}"
                            AutomationProperties.Name="{loc:Text Close}" VerticalAlignment="Top" HorizontalAlignment="Right" />
                </Grid>

                <TextBlock Text="{loc:Text SuiteFamily}" Style="{StaticResource Text.Subtitle}" Margin="0,0,0,8" />
                <ItemsControl x:Name="FamilyList" Margin="0,0,0,16">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Image Source="{Binding Icon}" Width="24" Height="24" AutomationProperties.Name="{Binding Name}" />
                                <StackPanel Grid.Column="1" Margin="8,0">
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource Text.BodyStrong}" />
                                    <TextBlock Text="{Binding Status}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" VerticalAlignment="Center" Visibility="{Binding DownloadVisibility}">
                                    <Hyperlink NavigateUri="{Binding DownloadUrl}" RequestNavigate="Hyperlink_RequestNavigate" Foreground="{DynamicResource Brush.Accent}">
                                        <Run Text="{Binding DownloadLabel}" />
                                    </Hyperlink>
                                </TextBlock>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <!-- Ayirici cizgi -->
                <Border Height="1" Background="{DynamicResource Brush.Border.Default}" Margin="0,0,0,16" />

                <!-- Kart Bilgileri -->
                <Border Background="{DynamicResource Brush.Bg.Surface}"
                        BorderBrush="{DynamicResource Brush.Border.Default}"
                        BorderThickness="1" CornerRadius="{StaticResource Radius.Control}"
                        Padding="16,14" Margin="0,0,0,16">
                    <StackPanel>
                        <!-- Instagram -->
                        <TextBlock Style="{StaticResource Text.Body}" Margin="0,0,0,10">
                            <Run Text="{loc:Text Instagram}" Foreground="{DynamicResource Brush.Text.Secondary}" FontWeight="SemiBold" />
                            <Hyperlink NavigateUri="https://www.instagram.com/tdesk.studio" RequestNavigate="Hyperlink_RequestNavigate"
                                       Foreground="{DynamicResource Brush.Accent}" TextDecorations="None"
                                       ToolTip="{loc:Text InstagramHelp}">
                                <Run Text="tdesk.studio" FontWeight="Bold" />
                            </Hyperlink>
                        </TextBlock>

                        <Border Height="1" Background="{DynamicResource Brush.Border.Default}" Margin="0,0,0,10" />

                        <!-- Imza -->
                        <TextBlock Style="{StaticResource Text.Muted}" FontSize="10.5" FontStyle="Italic">
                            <Run Text="{loc:Text Signature}" Foreground="{DynamicResource Brush.Text.Muted}" />
                            <Run Text="{loc:Text DeveloperName}" Foreground="{DynamicResource Brush.Text.Primary}" FontWeight="SemiBold" />
                        </TextBlock>
                    </StackPanel>
                </Border>

                <TextBlock Text="{loc:Text Language}" Style="{StaticResource Text.Body}" Margin="0,0,0,4" />
                <ComboBox x:Name="LanguageBox" Margin="0,0,0,16" SelectionChanged="Language_Changed"
                          AutomationProperties.Name="{loc:Text Language}" />

                <Border Background="{DynamicResource Brush.Bg.Surface}" Padding="12" CornerRadius="8" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="{loc:Text BridgeLine}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,0,0,8" />
                        <Button x:Name="BridgeButton" Content="{loc:Text GetBridge}" Style="{StaticResource Button.Secondary}"
                                Click="Bridge_Click" HorizontalAlignment="Left" />
                    </StackPanel>
                </Border>
                <!-- Güncelleme denetimi -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button Content="{loc:Text CheckUpdates}" Style="{StaticResource Button.Secondary}"
                            Command="{Binding CheckCommand}" AutomationProperties.Name="{loc:Text CheckUpdates}" />
                    <TextBlock Grid.Column="1" Text="{Binding CheckStatus}" Style="{StaticResource Text.Secondary}"
                               TextWrapping="Wrap" Margin="12,0,0,0" VerticalAlignment="Center"
                               AutomationProperties.LiveSetting="Polite" />
                </Grid>

                <CheckBox x:Name="StartWithWindowsCheckBox" Content="{loc:Text StartWindows}"
                          Foreground="{DynamicResource Brush.Text.Secondary}" Margin="0,0,0,16"
                          Click="StartWithWindows_Click" />

                <CheckBox x:Name="AutoReportsCheckBox" Content="{loc:Text PrepareReports}"
                          Foreground="{DynamicResource Brush.Text.Secondary}" Margin="0,0,0,12"
                          Click="AutoReports_Click" />
                <Button Content="{loc:Text SendReport}" Style="{StaticResource Button.Secondary}"
                        HorizontalAlignment="Left" Margin="0,0,0,16" Click="Report_Click" />

                <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,0,0,12"
                           Text="{loc:Text PrivacySummary}" />
                <TextBlock Style="{StaticResource Text.Caption}" Margin="0,0,0,12">
                    <Hyperlink NavigateUri="https://github.com/taha-sa/t-desktree" RequestNavigate="Hyperlink_RequestNavigate" Foreground="{DynamicResource Brush.Accent}"><Run Text="{loc:Text ReportSource}" /></Hyperlink>
                </TextBlock>
                <Button Content="{loc:Text CopyDiagnostics}" Style="{StaticResource Button.Secondary}" Click="CopyDiagnostics_Click" HorizontalAlignment="Left" Margin="0,0,0,12" />
                <Button Content="{loc:Text Legal}" Style="{StaticResource Button.Secondary}"
                        Click="Legal_Click" HorizontalAlignment="Left" Margin="0,0,0,12" />
                <!-- Kapat Butonu -->
                <Button Content="{loc:Text Close}" Style="{StaticResource Button.Primary}"
                        MinWidth="96" HorizontalAlignment="Right" IsCancel="True" Click="Close_Click" />
            </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
